{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lost-talent",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/verify*"]
  }
}
